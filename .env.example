# Copy to .env and fill in what you use. Every value is optional: with nothing set the app
# runs fully offline on SQLite + embedded Qdrant + template installation notes.

# --- Relational catalog (Neon or Supabase free tier) ---------------------------------------
# DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/roomspec?sslmode=require

# --- Vector store (Qdrant Cloud free tier) -------------------------------------------------
# QDRANT_URL=https://xxxxxxxx.eu-central-1-0.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=cabinet_modules

# --- Embeddings: auto | clip | hash  (hash needs no torch; use it on 512 MB hosts) ---------
EMBEDDING_BACKEND=auto

# --- LLM for installation notes: auto | groq | gemini | none -------------------------------
LLM_PROVIDER=auto
# GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

LOG_LEVEL=INFO
