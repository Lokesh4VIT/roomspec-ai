# Copy to .env and fill in what you use. Every value is optional: with nothing set the app
# runs fully offline on SQLite + embedded Qdrant + template installation notes.

# --- Relational catalog (Neon or Supabase free tier) ---------------------------------------
# DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/roomspec?sslmode=require

# --- Vector store (Qdrant Cloud free tier) -------------------------------------------------
# QDRANT_URL=https://xxxxxxxx.eu-central-1-0.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=cabinet_modules

# --- Embeddings: auto | clip | hash  (hash needs no torch; use it on 512 MB hosts) ---------
EMBEDDING_BACKEND=auto

# --- LLM for installation notes: auto | groq | gemini | none -------------------------------
LLM_PROVIDER=auto
# GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

LOG_LEVEL=INFO

# --- Features -------------------------------------------------------------------------------
MAX_ALTERNATIVES=3          # other finishes solved per request (0 disables)
SAVE_SPECS=true             # store results for share links (photos are never stored)
METRICS_ENABLED=true        # Prometheus metrics at /metrics

# --- Security (leave empty for open local development) -------------------------------------
# API_KEYS=key-one,key-two          # required as X-API-Key on /spec, /bom, /search
# ADMIN_API_KEYS=long-random-value  # enables /api/v1/admin/*
# RATE_LIMIT_PER_MINUTE=30          # per client; 0 = unlimited
# CORS_ORIGINS=https://roomspec.example.com
